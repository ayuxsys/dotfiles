#!/bin/bash

# overrides
alias mv='mv -i'
alias cat='bat --paging never --decorations never --plain'

# fzf
alias dirf='fd -H -t d | fzf'
alias cdf='cd $(fd -H -t d | fzf)'
alias zf='zed $(fd -H -t d | fzf)'
alias codef='code $(fd -H -t d | fzf)'

# yt-dlp wrappers

## Music
alias ytmdl='yt-dlp -x --audio-format mp3 --audio-quality 0'
alias ytmpdl='yt-dlp --yes-playlist -x --audio-format mp3 --audio-quality 0 --embed-metadata --embed-thumbnail -o "%(playlist_title)s/%(playlist_index)03d - %(title)s.%(ext)s"'

## Video
alias ytdl='yt-dlp -f "bv*+ba/b" --merge-output-format mp4'
alias ytpdl='yt-dlp --yes-playlist -f "bv*+ba/b" --merge-output-format mp4 -o "%(playlist_title)s/%(playlist_index)03d - %(title)s.%(ext)s"'

alias wgetdl='wget -c --content-disposition'
